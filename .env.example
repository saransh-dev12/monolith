# Supabase project URL (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable key (safe to expose; database access must still be protected by RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase service-role key for planner quota. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side OpenAI credentials for the planner. Never prefix the key with NEXT_PUBLIC_.
# Leave both empty or set them to "placeholder" to disable AI planning locally.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: point at an OpenAI-compatible endpoint. Leave unset for the normal API.
OPENAI_BASE_URL=

# Per-user daily generation limit, enforced in Postgres. Integer from 1 to 50.
PLANNER_DAILY_LIMIT=5

# Canonical app origin used for auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
