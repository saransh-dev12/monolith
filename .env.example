# Supabase project URL (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable key (safe to expose; database access must still be protected by RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side OpenAI API credentials. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key

# Model identifier selected and verified when the AI integration is implemented.
OPENAI_MODEL=your-supported-model-id

# Canonical app origin used to configure auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
